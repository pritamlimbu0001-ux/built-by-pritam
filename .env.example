APP_NAME="Pritam Limbu | Portfolio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -------------------------------------------------------------------------
# DATABASE — pick ONE option:
#
# OPTION A — SQLite (zero setup, recommended for local dev):
DB_CONNECTION=sqlite
# (uses the database/database.sqlite file shipped with this project)
#
# OPTION B — MySQL:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=portfolio
# DB_USERNAME=root
# DB_PASSWORD=
#
# Create the MySQL database first:
#   CREATE DATABASE portfolio CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# -------------------------------------------------------------------------

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync

# Contact form notifications are delivered here.
# PLACEHOLDER: replace with your real email address.
MAIL_TO_ADDRESS=your-email@example.com

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="portfolio@example.com"
MAIL_FROM_NAME="${APP_NAME}"
